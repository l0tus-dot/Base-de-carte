    "deletedAt": null,
    "subjectId": "9ec8462d-043b-5b77-a95d-2512ca408c0e",
    "name": "Images et conteneurs",
    "parentId": "4545849b-dee1-5d57-9e41-2c5f56b86094"
   }
  ],
  "cards": [
   {
    "id": "38ad1725-4f57-5801-843b-4c63aadd7e86",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande recherche une image sur Docker Hub ?",
    "back": "docker search <terme>",
    "createdAt": "2000-01-01T00:00:00.000Z"
   },
   {
    "id": "feee924b-bce6-59b0-82c2-c2996fd34f8a",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment filtrer docker search par popularité ?",
    "back": "docker search <terme> --filter stars=50",
    "createdAt": "2000-01-01T00:00:01.000Z"
   },
   {
    "id": "bacba345-1d43-5931-ae12-4a125d0dd4d7",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment limiter le nombre de résultats de docker search ?",
    "back": "docker search <terme> --limit 5",
    "createdAt": "2000-01-01T00:00:02.000Z"
   },
   {
    "id": "859cbee4-3c52-5baf-9a07-c2837f8d612b",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande télécharge la dernière version d'une image ?",
    "back": "docker pull <image> (tag :latest par défaut).",
    "createdAt": "2000-01-01T00:00:03.000Z"
   },
   {
    "id": "3ef587f4-b525-55fb-8c48-aa0e51a4ec4f",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment télécharger une version précise d'une image ?",
    "back": "docker pull <image>:<tag> (ex. ubuntu:22.04).",
    "createdAt": "2000-01-01T00:00:04.000Z"
   },
   {
    "id": "a67d2e2b-b1cc-5f66-b80c-15bebe9aba83",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment forcer l'architecture cible d'un pull ?",
    "back": "docker pull <image> --platform linux/amd64",
    "createdAt": "2000-01-01T00:00:05.000Z"
   },
   {
    "id": "e3952a54-fbf7-504e-9e0f-bb5922013a95",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande liste les images locales ?",
    "back": "docker images (alias : docker image ls).",
    "createdAt": "2000-01-01T00:00:06.000Z"
   },
   {
    "id": "44d03517-1c6c-58e5-9ecf-229b50a518d1",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker images -a ?",
    "back": "Elle inclut les couches intermédiaires.",
    "createdAt": "2000-01-01T00:00:07.000Z"
   },
   {
    "id": "c938f77c-f3f5-5989-a9f4-3623554898bb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande affiche la configuration complète d'une image en JSON ?",
    "back": "docker inspect <image>",
    "createdAt": "2000-01-01T00:00:08.000Z"
   },
   {
    "id": "07964646-1ef5-5c29-91e8-ad81e7add173",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment extraire un champ précis avec docker inspect ?",
    "back": "Avec --format, par exemple docker inspect <image> --format '{{ .Config.Env }}'.",
    "createdAt": "2000-01-01T00:00:09.000Z"
   },
   {
    "id": "4ec05249-6e63-5220-815b-dd8458db2a21",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker history <image> ?",
    "back": "Elle affiche les couches qui composent l'image et leur taille.",
    "createdAt": "2000-01-01T00:00:10.000Z"
   },
   {
    "id": "3d60a40e-148d-55a9-8c28-d2c9f9e8646f",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande supprime une image locale ?",
    "back": "docker rmi <image> (ou docker rmi <image>:<tag> pour un tag précis).",
    "createdAt": "2000-01-01T00:00:11.000Z"
   },
   {
    "id": "faff0d07-ff44-5beb-b856-dfc48379e004",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker image prune ?",
    "back": "Elle supprime les images dangling (sans tag ni conteneur associé).",
    "createdAt": "2000-01-01T00:00:12.000Z"
   },
   {
    "id": "295e96d0-0fa1-5005-b80c-4671838867cf",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker image prune -a ?",
    "back": "Elle supprime toutes les images sans conteneur associé.",
    "createdAt": "2000-01-01T00:00:13.000Z"
   },
   {
    "id": "69f93dd9-fd5c-50cf-9f30-811a4841cc56",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment exporter une image sans registry ?",
    "back": "docker save <image>:<tag> -o <archive>.tar",
    "createdAt": "2000-01-01T00:00:14.000Z"
   },
   {
    "id": "0ac2192c-24a8-5999-a18b-812166feb826",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment importer une image depuis un fichier tar ?",
    "back": "docker load -i <archive>.tar",
    "createdAt": "2000-01-01T00:00:15.000Z"
   },
   {
    "id": "db730980-d4ee-5190-8a31-736e86dce01f",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Pourquoi utiliser docker save et docker load ?",
    "back": "Pour transférer une image vers un hôte sans accès au dépôt d'origine.",
    "createdAt": "2000-01-01T00:00:16.000Z"
   },
   {
    "id": "1cd28c9a-22d2-5425-8a26-e1ef4b7471cb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker run <image> sans option ?",
    "back": "Il lance le conteneur et il s'arrête après l'exécution.",
    "createdAt": "2000-01-01T00:00:17.000Z"
   },
   {
    "id": "8020fb10-462f-5c4a-ba1b-6fc2d4537f34",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker run -d ?",
    "back": "Il lance le conteneur en mode détaché (arrière-plan).",
    "createdAt": "2000-01-01T00:00:18.000Z"
   },
   {
    "id": "814964cf-d465-5861-8388-5e36e189e872",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker run -it <image> /bin/bash ?",
    "back": "Il ouvre un shell interactif dans le conteneur.",
    "createdAt": "2000-01-01T00:00:19.000Z"
   },
   {
    "id": "ca2fce3f-b696-58e0-8793-2ec52e6f3dff",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker run --name <nom> ?",
    "back": "Il nomme le conteneur.",
    "createdAt": "2000-01-01T00:00:20.000Z"
   },
   {
    "id": "3b310536-8cbe-53d8-84d0-760fb0dd8ab3",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker run --rm ?",
    "back": "Il supprime automatiquement le conteneur après son arrêt.",
    "createdAt": "2000-01-01T00:00:21.000Z"
   },
   {
    "id": "2cf1375c-8e3a-5e06-881c-f6764bc42228",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment passer une variable d'environnement à un conteneur ?",
    "back": "docker run -e VAR=valeur <image>, ou depuis un fichier avec --env-file .env.",
    "createdAt": "2000-01-01T00:00:22.000Z"
   },
   {
    "id": "053d2ddd-03af-5125-a040-60d7e7325833",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que signifie -p 8080:80 dans docker run ?",
    "back": "Port de l'hôte : port du conteneur (ici le port 8080 de l'hôte est redirigé vers le port 80 du conteneur).",
    "createdAt": "2000-01-01T00:00:23.000Z"
   },
   {
    "id": "7e87bacf-3713-5ad6-ad8d-ebc329bc3d40",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait -v /chemin/hôte:/chemin/conteneur ?",
    "back": "Il monte un répertoire de l'hôte dans le conteneur (bind mount).",
    "createdAt": "2000-01-01T00:00:24.000Z"
   },
   {
    "id": "f357bdc5-db87-5f50-8036-1c10c2f3e1c7",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait l'option --restart unless-stopped ?",
    "back": "Le conteneur redémarre sauf s'il a été arrêté manuellement. Recommandé en production.",
    "createdAt": "2000-01-01T00:00:25.000Z"
   },
   {
    "id": "466f1299-2cff-51df-9692-db1ef0ae9f95",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que signifie la politique de redémarrage « no » ?",
    "back": "C'est la valeur par défaut : le conteneur n'est jamais redémarré.",
    "createdAt": "2000-01-01T00:00:26.000Z"
   },
   {
    "id": "fb76f0e1-11c8-52c0-bc32-789303adb770",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que signifie la politique de redémarrage « on-failure[:n] » ?",
    "back": "Redémarrage en cas d'erreur, n fois au maximum.",
    "createdAt": "2000-01-01T00:00:27.000Z"
   },
   {
    "id": "9d393172-9062-5971-92c2-e5866fbe01fb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que signifie la politique de redémarrage « always » ?",
    "back": "Le conteneur est toujours redémarré, même après un docker stop.",
    "createdAt": "2000-01-01T00:00:28.000Z"
   },
   {
    "id": "b687883e-fa3a-515b-a9b2-8b463f015c29",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande liste les conteneurs actifs ?",
    "back": "docker ps",
    "createdAt": "2000-01-01T00:00:29.000Z"
   },
   {
    "id": "0cea56e8-daa4-5e8b-997c-23345dd85735",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande liste tous les conteneurs, y compris arrêtés ?",
    "back": "docker ps -a",
    "createdAt": "2000-01-01T00:00:30.000Z"
   },
   {
    "id": "74d89042-d084-5537-bcf0-25d4c32cfbd6",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment ouvrir un nouveau shell dans un conteneur en cours d'exécution ?",
    "back": "docker exec -it <conteneur> /bin/bash",
    "createdAt": "2000-01-01T00:00:31.000Z"
   },
   {
    "id": "4d7ca115-8fb2-5f9a-b2de-08d9ea61e8cf",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment exécuter une commande dans un conteneur sans shell interactif ?",
    "back": "docker exec <conteneur> <commande>",
    "createdAt": "2000-01-01T00:00:32.000Z"
   },
   {
    "id": "74b4c7b1-742a-5f1d-9bbe-b5567c63a43e",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker attach ?",
    "back": "Elle rattache le terminal au processus principal du conteneur.",
    "createdAt": "2000-01-01T00:00:33.000Z"
   },
   {
    "id": "6139f1c1-5216-507d-b1c0-227e3e023677",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment se détacher d'un conteneur sans l'arrêter ?",
    "back": "Ctrl + P puis Ctrl + Q (dans un shell lancé avec -it).",
    "createdAt": "2000-01-01T00:00:34.000Z"
   },
   {
    "id": "686a3aee-b5ef-5546-bb6c-8de3c9a8fb16",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que se passe-t-il si on tape exit dans un shell interactif de conteneur ?",
    "back": "Le shell se ferme et le conteneur s'arrête si aucun autre processus n'y tourne.",
    "createdAt": "2000-01-01T00:00:35.000Z"
   },
   {
    "id": "87156821-f415-573d-b01e-8ad15781538d",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker stop ?",
    "back": "Elle envoie SIGTERM, puis SIGKILL après 10 secondes.",
    "createdAt": "2000-01-01T00:00:36.000Z"
   },
   {
    "id": "a841036a-05ba-5061-87b7-49e3b5c6380b",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment personnaliser le délai avant SIGKILL d'un docker stop ?",
    "back": "docker stop -t 30 <conteneur>",
    "createdAt": "2000-01-01T00:00:37.000Z"
   },
   {
    "id": "ccc42c79-30e6-52ac-aafd-055b5c5e44b8",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker kill ?",
    "back": "Elle envoie un SIGKILL immédiat.",
    "createdAt": "2000-01-01T00:00:38.000Z"
   },
   {
    "id": "742454f9-892c-5a2b-9e07-0bf3548f0243",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande arrête puis relance un conteneur ?",
    "back": "docker restart <conteneur>",
    "createdAt": "2000-01-01T00:00:39.000Z"
   },
   {
    "id": "7fd62146-944e-59ec-9e45-ba4338a20a71",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande démarre un conteneur arrêté ?",
    "back": "docker start <conteneur> (avec -i pour un shell interactif).",
    "createdAt": "2000-01-01T00:00:40.000Z"
   },
   {
    "id": "eba679b6-abda-5c24-8dcd-c6c02f301bad",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que font docker pause et docker unpause ?",
    "back": "docker pause suspend tous les processus du conteneur (cgroup freeze), docker unpause les reprend.",
    "createdAt": "2000-01-01T00:00:41.000Z"
   },
   {
    "id": "1d48a335-d949-5e12-832e-dc869007febc",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande supprime un conteneur ?",
    "back": "docker rm <conteneur> (il doit être arrêté), ou docker rm -f pour forcer la suppression même s'il tourne.",
    "createdAt": "2000-01-01T00:00:42.000Z"
   },
   {
    "id": "979e3207-5682-5f38-a243-70139660c893",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker container prune ?",
    "back": "Elle supprime tous les conteneurs arrêtés.",
    "createdAt": "2000-01-01T00:00:43.000Z"
   },
   {
    "id": "538a105a-cc13-540a-b008-e465e710e4f1",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Pourquoi faut-il éviter docker rm -f $(docker ps -aq) tel quel ?",
    "back": "Il supprime tous les conteneurs de l'hôte sans distinction. À réserver aux tests volontaires.",
    "createdAt": "2000-01-01T00:00:44.000Z"
   },
   {
    "id": "a22bb48e-d219-52dc-8005-a8377b30bcfb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande affiche les logs d'un conteneur ?",
    "back": "docker logs <conteneur> (flux stdout/stderr).",
    "createdAt": "2000-01-01T00:00:45.000Z"
   },
   {
    "id": "54986ac0-2627-5c35-99ca-3324332d5801",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment suivre les logs en temps réel ?",
    "back": "docker logs -f <conteneur>",
    "createdAt": "2000-01-01T00:00:46.000Z"
   },
   {
    "id": "9ebb696a-0aa5-56c7-88c5-e88d31854727",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment afficher les 50 dernières lignes des logs ?",
    "back": "docker logs --tail 50 <conteneur>",
    "createdAt": "2000-01-01T00:00:47.000Z"
   },
   {
    "id": "1534c17f-7ba5-5a52-a9e0-4c6abb41e689",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Comment afficher les logs depuis 1 heure ?",
    "back": "docker logs --since 1h <conteneur>",
    "createdAt": "2000-01-01T00:00:48.000Z"
   },
   {
    "id": "91280844-efa0-5f53-b5f4-94c99a4ec341",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Quelle commande affiche le statut d'un conteneur ?",
    "back": "docker inspect <conteneur> --format '{{ .State.Status }}'",
    "createdAt": "2000-01-01T00:00:49.000Z"
   },
   {
    "id": "d9d4ad79-2a22-583b-9d64-27d65014960f",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker stats ?",
    "back": "Elle affiche en direct le CPU, la mémoire et les I/O des conteneurs.",
    "createdAt": "2000-01-01T00:00:50.000Z"
   },
   {
    "id": "6205730b-b3b4-5bdd-a1c8-102579d70730",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker top <conteneur> ?",
    "back": "Elle affiche les processus en cours dans le conteneur.",
    "createdAt": "2000-01-01T00:00:51.000Z"
   },
   {
    "id": "b9e80a47-9ed0-5e83-86d3-569452551772",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker diff <conteneur> ?",
    "back": "Elle affiche les fichiers modifiés depuis le démarrage du conteneur.",
    "createdAt": "2000-01-01T00:00:52.000Z"
   },
   {
    "id": "5850595d-434c-50de-b3c8-417eeadf68ba",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "55657704-fd9b-5661-aa9a-10cf4a084d0a",
    "front": "Que fait docker port <conteneur> ?",
    "back": "Elle affiche les mappages de ports actifs.",
    "createdAt": "2000-01-01T00:00:53.000Z"
   }
