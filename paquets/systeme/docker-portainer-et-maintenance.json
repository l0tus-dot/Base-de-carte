    "subjectId": "9ec8462d-043b-5b77-a95d-2512ca408c0e",
    "name": "Portainer et maintenance",
    "parentId": "4545849b-dee1-5d57-9e41-2c5f56b86094"
   }
  ],
  "cards": [
   {
    "id": "f8146b8d-035e-5cc3-8983-9f29c226b2e6",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Qu'est-ce que Portainer ?",
    "back": "Une interface web complète pour gérer les conteneurs, images, volumes et réseaux de Docker.",
    "createdAt": "2000-01-01T00:00:00.000Z"
   },
   {
    "id": "1074b37a-c58d-5708-ae63-631f6ba0ee23",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Comment lance-t-on Portainer ?",
    "back": "On crée un volume portainer_data, puis docker run -d --name portainer --restart unless-stopped -p 9000:9000 -v /var/run/docker.sock:/var/run/docker.sock -v portainer_data:/data portainer/portainer-ce:latest.",
    "createdAt": "2000-01-01T00:00:01.000Z"
   },
   {
    "id": "e7ecc9df-f9ce-5df2-880c-cb372292e904",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Pourquoi Portainer monte-t-il /var/run/docker.sock ?",
    "back": "Pour communiquer avec le démon Docker de l'hôte et le piloter.",
    "createdAt": "2000-01-01T00:00:02.000Z"
   },
   {
    "id": "aaad971a-11e0-58f4-a8a6-9bf5cda45540",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "À quoi sert le volume portainer_data ?",
    "back": "Il conserve les données de Portainer (dans /data).",
    "createdAt": "2000-01-01T00:00:03.000Z"
   },
   {
    "id": "400adb9d-b0b6-5872-be38-6cd39f34f85f",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Comment accéder à Portainer ?",
    "back": "Depuis un navigateur : http://<adresse-ip-serveur>:9000. Le mot de passe administrateur est défini au premier lancement.",
    "createdAt": "2000-01-01T00:00:04.000Z"
   },
   {
    "id": "6b4cf37e-11d8-5b94-aaf4-6377dfc5c7f1",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Où peut-on intégrer Portainer pour faciliter sa mise à jour ?",
    "back": "Dans un compose.yml, aux côtés des autres services.",
    "createdAt": "2000-01-01T00:00:05.000Z"
   },
   {
    "id": "3316dae1-be47-559b-9a51-cfa31efb0dac",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle commande supprime les conteneurs arrêtés ?",
    "back": "docker container prune",
    "createdAt": "2000-01-01T00:00:06.000Z"
   },
   {
    "id": "7972250d-67f0-51a0-9f55-edbf6208e751",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle commande supprime les images dangling ?",
    "back": "docker image prune",
    "createdAt": "2000-01-01T00:00:07.000Z"
   },
   {
    "id": "2809ae50-cac2-56a8-b4df-069a2a83ec00",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle commande supprime toutes les images non utilisées ?",
    "back": "docker image prune -a",
    "createdAt": "2000-01-01T00:00:08.000Z"
   },
   {
    "id": "442df26f-2fd9-5065-8c35-60e6635f7562",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle commande supprime les volumes non rattachés à un conteneur ?",
    "back": "docker volume prune",
    "createdAt": "2000-01-01T00:00:09.000Z"
   },
   {
    "id": "e032ad78-42d1-5b74-8a9d-35a6f17768f7",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle commande supprime les réseaux inutilisés ?",
    "back": "docker network prune",
    "createdAt": "2000-01-01T00:00:10.000Z"
   },
   {
    "id": "69a0f9f2-2be5-56d8-a0f1-e2233f15cbe0",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle commande affiche l'espace occupé par images, conteneurs et volumes ?",
    "back": "docker system df",
    "createdAt": "2000-01-01T00:00:11.000Z"
   },
   {
    "id": "093e067d-c5ed-5854-ae5a-4e4ffad1ed7d",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Que fait docker system prune ?",
    "back": "Elle supprime les conteneurs arrêtés, les images dangling et les réseaux inutilisés.",
    "createdAt": "2000-01-01T00:00:12.000Z"
   },
   {
    "id": "d5aff05f-6ee9-5ab5-96ec-323fc83603aa",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Que fait docker system prune -a ?",
    "back": "Elle inclut toutes les images non utilisées.",
    "createdAt": "2000-01-01T00:00:13.000Z"
   },
   {
    "id": "0eed526e-afd6-5855-abcc-09615e2ed8a8",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Que fait docker system prune -a --volumes ?",
    "back": "Elle inclut aussi les volumes.",
    "createdAt": "2000-01-01T00:00:14.000Z"
   },
   {
    "id": "4d806d03-2f97-5776-a039-963c7e048293",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Pourquoi docker system prune -a --volumes est-il irréversible ?",
    "back": "Il supprime toutes les données non actives sans confirmation individuelle. À n'utiliser que sur un environnement que l'on est prêt à reconstruire entièrement.",
    "createdAt": "2000-01-01T00:00:15.000Z"
   },
   {
    "id": "8b835ffb-47cc-550c-aa38-684ddf4a6bdd",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelle séquence désinstalle complètement Docker ?",
    "back": "Supprimer tous les conteneurs (docker rm -f $(docker ps -aq)), les images (docker rmi -f $(docker images -q)), les volumes (docker volume prune -f), purger les paquets docker-ce, docker-ce-cli, containerd.io, docker-buildx-plugin et docker-compose-plugin, puis sudo rm -rf /var/lib/docker /etc/docker.",
    "createdAt": "2000-01-01T00:00:16.000Z"
   },
   {
    "id": "7f547521-94ba-521a-a19a-d59a4994f6fa",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Pourquoi la séquence de désinstallation est-elle dangereuse ?",
    "back": "Elle supprime tout Docker et ses données sur l'hôte. À réserver à une désinstallation complète décidée délibérément, jamais à un retour arrière partiel.",
    "createdAt": "2000-01-01T00:00:17.000Z"
   },
   {
    "id": "352d74d3-cc08-5c56-946e-ab9ded1c40cf",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Pourquoi l'espace disque reste-t-il occupé après un nettoyage ciblé ?",
    "back": "Des images ou volumes sont encore référencés par un conteneur arrêté, non couverts par prune seul. Utiliser docker system df pour localiser le poste, puis docker system prune -a --volumes si tout est voué à la suppression.",
    "createdAt": "2000-01-01T00:00:18.000Z"
   },
   {
    "id": "db190fdc-44f4-5d39-8d0f-5cbe64392858",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "dc377c63-e9bc-5b82-9076-b078eaab2e54",
    "front": "Quelles commandes vérifient l'état après un nettoyage ?",
    "back": "docker system df, docker ps -a, docker images, docker network ls et docker volume ls.",
    "createdAt": "2000-01-01T00:00:19.000Z"
   }
  ],
