   },
   {
    "id": "bd45082c-e7af-5d37-afec-fa2b823b1563",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Citez un serveur mail propriétaire et un libre.",
    "back": "Propriétaire : MS Exchange. Libre : Zimbra, Postfix.",
    "createdAt": "2000-01-01T00:00:44.000Z"
   },
   {
    "id": "29418c9e-172a-564d-a2b3-9975a154db12",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Qu'est-ce que la double licence ?",
    "back": "Une clause de licence qui permet à un utilisateur d'une œuvre protégée par le droit d'auteur de l'utiliser en se conformant à l'un de deux ensembles de conditions.",
    "createdAt": "2000-01-01T00:00:45.000Z"
   },
   {
    "id": "483ce538-11a3-56ff-a237-4dc699f28ee9",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Quels sont les deux ensembles de conditions d'une double licence ?",
    "back": "Une licence libre open source pour le produit standard, et une licence commerciale propriétaire, plus protégée, avec garantie et plus de fonctionnalités.",
    "createdAt": "2000-01-01T00:00:46.000Z"
   },
   {
    "id": "117bbc17-438a-5668-a28c-907a846ab404",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Qu'est-ce que le domaine public ?",
    "back": "L'ensemble des créations intellectuelles dont les droits d'exploitation liés au droit d'auteur sont expirés.",
    "createdAt": "2000-01-01T00:00:47.000Z"
   },
   {
    "id": "9d3160b6-efde-58ce-867a-38ad284c10c3",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Quelle est la durée des droits d'exploitation selon la convention de Berne (1886) ?",
    "back": "70 ans après la mort de l'auteur, ou 70 ans à dater de la première diffusion (si la diffusion est posthume, ou si l'œuvre est créée par plusieurs auteurs).",
    "createdAt": "2000-01-01T00:00:48.000Z"
   },
   {
    "id": "2733fe37-463e-513b-8e1a-b6c3b31e4961",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Y a-t-il beaucoup de logiciels dans le domaine public ?",
    "back": "Il y en a peu : ce sont des logiciels abandonnés par leurs auteurs, développés bénévolement (souvent dans le cadre universitaire).",
    "createdAt": "2000-01-01T00:00:49.000Z"
   },
   {
    "id": "9fecbcd7-14fd-5d00-9099-bbab8756a0d1",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "9cc3a80a-6970-55e3-b69b-6c7429b2f2a3",
    "front": "Quelles sont les caractéristiques d'un logiciel du domaine public ?",
    "back": "Sa redistribution et son utilisation sont autorisées sans limitation, mais sa modification est souvent impossible car le code source est indisponible.",
    "createdAt": "2000-01-01T00:00:50.000Z"
   }
