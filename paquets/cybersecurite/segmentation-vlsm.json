  "decks": [
   {
    "id": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "subjectId": "5794b0db-006d-5efa-95bd-337af5765586",
    "name": "Segmentation VLSM"
   }
  ],
  "cards": [
   {
    "id": "16c9cc9c-4355-5a64-8d97-104d9527e2d9",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi segmenter un réseau « à plat » ?",
    "back": "Les diffusions (ARP, DHCP) atteignent toutes les machines et tout incident est à portée du reste. Segmenter réduit le domaine de diffusion, limite ce qu'un hôte compromis peut atteindre et permet des règles de filtrage par segment.",
    "createdAt": "2000-01-01T00:00:00.000Z"
   },
   {
    "id": "ab81437d-3aac-58b5-b648-09fe2381aef3",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Qu'est-ce que le VLSM ?",
    "back": "Variable Length Subnet Mask : on découpe un même bloc d'adresses en sous-réseaux de tailles différentes, chacun dimensionné au plus près du besoin.",
    "createdAt": "2000-01-01T00:00:01.000Z"
   },
   {
    "id": "3a66c787-97b0-5c4b-879c-1be0135315d7",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Quel défaut du découpage en blocs de taille identique le VLSM corrige-t-il ?",
    "back": "Les blocs identiques gaspillent des adresses sur les petits segments pour satisfaire les plus grands.",
    "createdAt": "2000-01-01T00:00:02.000Z"
   },
   {
    "id": "7511bd91-d814-5532-80b0-fc0b2f741de9",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Combien d'hôtes utilisables pour h bits de partie hôte ?",
    "back": "2^h - 2, car l'adresse réseau et l'adresse de diffusion sont exclues.",
    "createdAt": "2000-01-01T00:00:03.000Z"
   },
   {
    "id": "a5c45a56-a71c-5e12-a63d-a07da41d7141",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Combien de sous-réseaux obtient-on en empruntant s bits ?",
    "back": "2^s.",
    "createdAt": "2000-01-01T00:00:04.000Z"
   },
   {
    "id": "fc0c45aa-b77e-50ae-a82c-fab68f2b607e",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Comment trouver le masque minimal pour N hôtes ?",
    "back": "Prendre le plus petit /n tel que 2^(32-n) - 2 ≥ N.",
    "createdAt": "2000-01-01T00:00:05.000Z"
   },
   {
    "id": "31f45f4d-516b-5f76-b5ff-9f5f78433dd6",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Dans quel ordre alloue-t-on les sous-réseaux en VLSM ?",
    "back": "Du plus grand besoin au plus petit, chaque sous-réseau étant prélevé juste après le précédent dans le bloc disponible.",
    "createdAt": "2000-01-01T00:00:06.000Z"
   },
   {
    "id": "33f6b723-ebb4-552e-883d-cd4f0a677a4e",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi ne pas attribuer un petit sous-réseau en premier ?",
    "back": "Cela peut fragmenter l'espace restant au point de ne plus pouvoir caser un besoin plus grand, même si le total d'adresses libres suffirait.",
    "createdAt": "2000-01-01T00:00:07.000Z"
   },
   {
    "id": "931e1433-a343-556b-990c-864cbfdbb577",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Quel masque pour 100 hôtes et quel sous-réseau dans le bloc 192.168.1.0/24 ?",
    "back": "2^7 - 2 = 126 ≥ 100, donc 7 bits d'hôte et un /25. Le premier sous-réseau est 192.168.1.0/25.",
    "createdAt": "2000-01-01T00:00:08.000Z"
   },
   {
    "id": "62cb2483-d4c8-5c70-95ba-fade318de39a",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Quels masques de sous-réseau pour /25, /26 et /30 ?",
    "back": "/25 donne 255.255.255.128, /26 donne 255.255.255.192 et /30 donne 255.255.255.252.",
    "createdAt": "2000-01-01T00:00:09.000Z"
   },
   {
    "id": "5b44f941-9c8a-539a-8d79-46c0591c2cae",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Dans quel ordre retirer la configuration VLSM d'un routeur ?",
    "back": "D'abord les routes, puis les adresses d'interface avec no ip address. Une route vers un prochain saut sans adresse resterait invalide jusqu'au nettoyage complet.",
    "createdAt": "2000-01-01T00:00:10.000Z"
   },
   {
    "id": "2619aca1-759a-5d9a-a6e4-5b3ce485eca7",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Quelles commandes vérifient le plan d'adressage VLSM ?",
    "back": "show ip interface brief (chaque interface doit être up/up), show ip route et ping avec source.",
    "createdAt": "2000-01-01T00:00:11.000Z"
   },
   {
    "id": "68b856f1-a6a5-5550-9bb7-149e6fdf0838",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Que signifie une adresse qui déborde du sous-réseau prévu ?",
    "back": "C'est le signe d'une confusion entre deux blocs calculés, à repérer avant la mise en service.",
    "createdAt": "2000-01-01T00:00:12.000Z"
   },
   {
    "id": "96ef75ba-bc65-5e9a-a8a5-20b938c5e90c",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi deux sous-réseaux se chevauchent-ils partiellement ?",
    "back": "Le calcul du préfixe suivant est parti de la mauvaise adresse. Il faut reprendre l'adresse de diffusion du sous-réseau précédent + 1, pas une valeur arrondie.",
    "createdAt": "2000-01-01T00:00:13.000Z"
   },
   {
    "id": "567464af-f613-53e3-ae6f-bfc40267de15",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi un sous-réseau censé contenir N hôtes en contient-il moins ?",
    "back": "On a oublié de soustraire l'adresse réseau et l'adresse de diffusion (2^h - 2 et non 2^h).",
    "createdAt": "2000-01-01T00:00:14.000Z"
   },
   {
    "id": "687ecfe3-7eaa-5d32-879b-1ff7254dcf41",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi est-il impossible de caser le dernier sous-réseau alors qu'il reste assez d'adresses ?",
    "back": "Les besoins ont été traités dans le mauvais ordre (petit avant grand). Il faut repartir du bloc d'origine et réallouer du plus grand au plus petit.",
    "createdAt": "2000-01-01T00:00:15.000Z"
   },
   {
    "id": "1ab32109-c8a3-55e6-b1e4-274603784aee",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi un hôte ne peut-il pas joindre sa passerelle ?",
    "back": "L'adresse d'interface est hors de la plage valide du sous-réseau (adresse réseau ou diffusion utilisée par erreur). Comparer avec la plage calculée.",
    "createdAt": "2000-01-01T00:00:16.000Z"
   },
   {
    "id": "bc53d5b8-96d9-5d75-baa4-e1d1c45b7d85",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "5275f552-6a0b-52e6-b151-070dba2edf37",
    "front": "Pourquoi n'y a-t-il plus de place pour un futur sous-réseau ?",
    "back": "Aucune réserve n'a été laissée après l'allocation des besoins initiaux. Il faut dimensionner le bloc global avec une marge ou revoir le plan d'adressage.",
    "createdAt": "2000-01-01T00:00:17.000Z"
   }
  ],
