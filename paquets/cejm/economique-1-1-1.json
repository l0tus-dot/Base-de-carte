    "subjectId": "97f9aa4d-0953-52a6-9296-aaaaeb9eeef6",
    "name": "Les agents économiques et leurs échanges",
    "parentId": null
   },
   {
    "id": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "subjectId": "97f9aa4d-0953-52a6-9296-aaaaeb9eeef6",
    "name": "Economique",
    "parentId": "95958ca2-2e81-5c6a-a38c-95ba14ac58ac"
   }
  ],
  "cards": [
   {
    "id": "65b10770-29f3-56f0-aa05-6e29daf276c8",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'un agent économique ?",
    "back": "Un individu ou un groupe d'individus, centre de décision autonome, qui réalise des opérations économiques avec d'autres agents (consommer, produire, accorder des prêts, redistribuer des revenus).",
    "createdAt": "2000-01-01T00:00:00.000Z"
   },
   {
    "id": "2e138d84-ea6a-5210-b0f8-eff1cf002dab",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quel est le synonyme d'agent économique ?",
    "back": "Acteur économique.",
    "createdAt": "2000-01-01T00:00:01.000Z"
   },
   {
    "id": "9e7a32fd-18da-5718-8de9-2db272916bdd",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'un secteur institutionnel ?",
    "back": "Le groupement de millions d'agents économiques ayant la même fonction principale, réalisé par la Comptabilité nationale pour mieux étudier leur rôle et leur comportement.",
    "createdAt": "2000-01-01T00:00:02.000Z"
   },
   {
    "id": "907e3464-8a8e-5842-9447-6f2afcd57baa",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce que la Comptabilité nationale ?",
    "back": "Une représentation chiffrée de l'activité économique de la France, réalisée notamment par l'Insee.",
    "createdAt": "2000-01-01T00:00:03.000Z"
   },
   {
    "id": "b75b003b-6b75-5d05-a589-530b187eca93",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que signifie Insee ?",
    "back": "Institut national de la statistique et des études économiques.",
    "createdAt": "2000-01-01T00:00:04.000Z"
   },
   {
    "id": "379ab40a-51ff-55c1-b57b-6556d69f1a0e",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce que la consommation ?",
    "back": "L'acte d'acquérir des biens et services pour satisfaire les besoins des agents.",
    "createdAt": "2000-01-01T00:00:05.000Z"
   },
   {
    "id": "a5a047fa-9360-58ad-a8d1-971b352cfeff",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'une production marchande ?",
    "back": "Une production vendue sur un marché à un prix supérieur aux coûts de production, ce qui permet à l'offreur de réaliser un profit.",
    "createdAt": "2000-01-01T00:00:06.000Z"
   },
   {
    "id": "56504944-f7d6-5e8e-9d34-841539ca80ff",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'une production non marchande ?",
    "back": "Une production proposée gratuitement ou à un prix inférieur aux coûts de production (ex. : frais universitaires, entrée dans une piscine municipale, restaurant universitaire).",
    "createdAt": "2000-01-01T00:00:07.000Z"
   },
   {
    "id": "d137c743-4005-535f-b9bb-7bbf371249fb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quels sont les six secteurs institutionnels ?",
    "back": "Les ménages, les sociétés non financières (SNF), les sociétés financières (SF), les administrations publiques (APU), les institutions sans but lucratif au service des ménages (ISBLSM) et le reste du monde (RDM).",
    "createdAt": "2000-01-01T00:00:08.000Z"
   },
   {
    "id": "0142e1a1-98f0-5587-b9f7-391356e8d104",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les ménages ?",
    "back": "Les occupants d'un même logement avec ou sans lien de parenté. Les entreprises individuelles y sont incluses.",
    "createdAt": "2000-01-01T00:00:09.000Z"
   },
   {
    "id": "5e1e8b16-87a7-5da7-89c1-d819d9239043",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelle est la fonction principale des ménages ?",
    "back": "La consommation de biens et services.",
    "createdAt": "2000-01-01T00:00:10.000Z"
   },
   {
    "id": "89ce696d-06ed-51c4-bf79-42e334400943",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Pourquoi les entreprises individuelles sont-elles considérées comme des ménages ?",
    "back": "Parce qu'il n'y a pas de distinction juridique entre l'entrepreneur et son entreprise : le patrimoine de l'entreprise est intégré à celui du ménage auquel l'entrepreneur appartient.",
    "createdAt": "2000-01-01T00:00:11.000Z"
   },
   {
    "id": "d5071937-4a07-5f31-b003-eb2d46130867",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les sociétés non financières (SNF) ?",
    "back": "Les entreprises ayant un statut de société (SA, SAS, SARL, etc.) qui ne font pas d'opérations financières.",
    "createdAt": "2000-01-01T00:00:12.000Z"
   },
   {
    "id": "11f3baa7-c4d4-57a3-be0c-4d4bde190c23",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelle est la fonction principale des sociétés non financières ?",
    "back": "Produire des biens et des services marchands.",
    "createdAt": "2000-01-01T00:00:13.000Z"
   },
   {
    "id": "2967c9bd-ca53-5036-b137-72a05a6cb3fa",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les sociétés financières (SF) ?",
    "back": "Les agents qui financent l'économie : les banques, les assurances, les mutuelles et les fonds de pension.",
    "createdAt": "2000-01-01T00:00:14.000Z"
   },
   {
    "id": "d4bcae1e-d853-53a1-bf08-1074b68104fc",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelle est la fonction principale des sociétés financières ?",
    "back": "Produire des services financiers marchands.",
    "createdAt": "2000-01-01T00:00:15.000Z"
   },
   {
    "id": "e15d19b0-1188-5be5-ac1b-15fef540ccfa",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que comprennent les administrations publiques (APU) ?",
    "back": "Les administrations publiques centrales, les administrations publiques locales et les administrations de Sécurité sociale.",
    "createdAt": "2000-01-01T00:00:16.000Z"
   },
   {
    "id": "b1c62418-fb9e-5add-8afa-b104fa0f4ebe",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont les administrations publiques centrales ?",
    "back": "L'État, les ministères, la préfecture, les rectorats et les universités.",
    "createdAt": "2000-01-01T00:00:17.000Z"
   },
   {
    "id": "51ab3d41-ad3b-5195-8bee-4c13a02ce653",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont les administrations publiques locales ?",
    "back": "Les collectivités territoriales et les établissements publics d'enseignement.",
    "createdAt": "2000-01-01T00:00:18.000Z"
   },
   {
    "id": "a3f9a46d-0037-5b13-ba05-1d9acd5f2f92",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont les administrations de Sécurité sociale ?",
    "back": "L'URSSAF, la CAF et les hôpitaux.",
    "createdAt": "2000-01-01T00:00:19.000Z"
   },
   {
    "id": "f7278a36-5a99-558e-9bc3-5a707cecdfdd",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelle est la fonction principale des administrations publiques ?",
    "back": "Produire des services publics non marchands.",
    "createdAt": "2000-01-01T00:00:20.000Z"
   },
   {
    "id": "e568ab37-f7ca-524c-8051-d039bdec24e7",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les ISBLSM ?",
    "back": "Les organisations sans recherche de profit, au service des ménages : associations, fondations, partis politiques, syndicats.",
    "createdAt": "2000-01-01T00:00:21.000Z"
   },
   {
    "id": "96e58659-e7b4-50c5-ae29-6a7da14d9855",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelle est la fonction principale des ISBLSM ?",
    "back": "Produire des biens et services non marchands.",
    "createdAt": "2000-01-01T00:00:22.000Z"
   },
   {
    "id": "c212ea35-443e-528d-aa27-a36cde21f935",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que désigne le reste du monde (RDM) ?",
    "back": "L'ensemble des agents des autres pays ou des zones économiques (ex. : Union européenne) avec lesquels sont réalisés des échanges (importations ou exportations).",
    "createdAt": "2000-01-01T00:00:23.000Z"
   },
   {
    "id": "849093fb-0498-5375-934a-ab3c7b632407",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "À quel secteur institutionnel appartient un groupe de consommateurs comme UFC-Que Choisir ?",
    "back": "Aux ISBLSM : c'est une association sans but lucratif.",
    "createdAt": "2000-01-01T00:00:24.000Z"
   },
   {
    "id": "f6484f13-1200-5ffb-aea9-3399f34c8cc0",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "À quel secteur institutionnel appartient une entreprise qui répare et revend des smartphones ?",
    "back": "Aux sociétés non financières : elle produit des biens et services marchands.",
    "createdAt": "2000-01-01T00:00:25.000Z"
   },
   {
    "id": "0bbd3337-5014-5647-96e1-a0b5f330710e",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "À quel secteur institutionnel appartient la CAF ?",
    "back": "Aux administrations publiques (administration de Sécurité sociale) : elle produit des services non marchands.",
    "createdAt": "2000-01-01T00:00:26.000Z"
   },
   {
    "id": "e4e04c78-1c05-5284-83db-e24c026e91f5",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "À quel secteur institutionnel appartient un lycée professionnel public ?",
    "back": "Aux administrations publiques (administration locale) : il produit des services non marchands.",
    "createdAt": "2000-01-01T00:00:27.000Z"
   },
   {
    "id": "eb9e8bd6-47bf-56f3-9fad-21529f7bdcdb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "À quel secteur institutionnel appartient une banque comme la Banque populaire ?",
    "back": "Aux sociétés financières : elle produit des services financiers marchands.",
    "createdAt": "2000-01-01T00:00:28.000Z"
   },
   {
    "id": "f1d41a2e-3dd9-5869-8f74-965a07848cfb",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Pourquoi les individus échangent-ils des produits ?",
    "back": "Ils ne peuvent pas produire eux-mêmes tout ce dont ils ont besoin : ils se spécialisent dans une activité et échangent des produits (biens, services, travail, capitaux) contre un paiement en nature ou en monnaie.",
    "createdAt": "2000-01-01T00:00:29.000Z"
   },
   {
    "id": "d199f6e0-12dc-595a-8406-66e632f7f896",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce que le circuit économique ?",
    "back": "La représentation schématique des échanges entre les agents économiques, avec deux types de flux : les flux réels et les flux monétaires.",
    "createdAt": "2000-01-01T00:00:30.000Z"
   },
   {
    "id": "250a7dcd-2af7-5c09-9939-9412266d1a71",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'un flux réel ?",
    "back": "Un échange de services, de biens, de marchandises ou de matières premières.",
    "createdAt": "2000-01-01T00:00:31.000Z"
   },
   {
    "id": "2294f041-8b7a-5e72-a8da-6759cf1dcb52",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'un flux monétaire ?",
    "back": "Un échange de monnaie.",
    "createdAt": "2000-01-01T00:00:32.000Z"
   },
   {
    "id": "535fe2df-c583-586f-88fa-3b9481dc82fd",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les capitaux fixes ?",
    "back": "L'ensemble des actifs corporels ou incorporels destinés à être utilisés dans le processus de production pendant au moins un an. Ils correspondent à l'investissement.",
    "createdAt": "2000-01-01T00:00:33.000Z"
   },
   {
    "id": "dfec00b6-1328-5d7f-abaf-fb7e3efee666",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce que l'investissement ?",
    "back": "L'acquisition de capitaux fixes : l'achat de biens d'équipement durables (plus d'un an).",
    "createdAt": "2000-01-01T00:00:34.000Z"
   },
   {
    "id": "66e05f28-db3d-562d-9578-e082387b4c52",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les capitaux circulants ?",
    "back": "L'ensemble des moyens de production détruits ou transformés au cours du processus de production, dont la durée d'utilisation est inférieure à un an (matières premières, énergie).",
    "createdAt": "2000-01-01T00:00:35.000Z"
   },
   {
    "id": "cc2b7f62-0342-5773-a949-084501e0cbf5",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les consommations intermédiaires ?",
    "back": "L'achat de capital circulant : les valeurs qui n'ont pas été produites par l'entreprise mais par ses fournisseurs.",
    "createdAt": "2000-01-01T00:00:36.000Z"
   },
   {
    "id": "7e8a1359-67d2-5847-92b6-f2c9524e04a8",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Que sont les prélèvements obligatoires ?",
    "back": "L'ensemble des versements effectifs opérés par tous les agents économiques aux administrations publiques : impôts, taxes, cotisations sociales.",
    "createdAt": "2000-01-01T00:00:37.000Z"
   },
   {
    "id": "244d33a7-0057-53c7-b694-06b0846f3707",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'une subvention ?",
    "back": "Une aide financière allouée par une personne publique pour financer une activité d'intérêt général. Le bénéficiaire peut être public ou privé (entreprise, association, personne).",
    "createdAt": "2000-01-01T00:00:38.000Z"
   },
   {
    "id": "5c7b3ec4-9464-54ee-b8ff-203e178ce54c",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'un don ?",
    "back": "Une contribution volontaire en espèces ou en nature.",
    "createdAt": "2000-01-01T00:00:39.000Z"
   },
   {
    "id": "bcf9633b-2147-544f-aaea-f8468232cc55",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce que l'inflation ?",
    "back": "Une augmentation durable et générale des prix des biens et des services, aussi caractérisée par l'accroissement de la circulation de la monnaie (masse monétaire).",
    "createdAt": "2000-01-01T00:00:40.000Z"
   },
   {
    "id": "19304cfa-e982-5be8-87dd-90428bc91989",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce que la déflation ?",
    "back": "Un phénomène de baisse générale des prix constatée sur une période suffisamment longue.",
    "createdAt": "2000-01-01T00:00:41.000Z"
   },
   {
    "id": "a3836622-e5c5-5685-a163-bfe2f799d108",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Qu'est-ce qu'un crédit ?",
    "back": "L'acte par lequel une personne, généralement un banquier, met à la disposition d'une autre personne une somme d'argent ou un bien qui devra être restitué.",
    "createdAt": "2000-01-01T00:00:42.000Z"
   },
   {
    "id": "6a3625d8-1a64-577e-bae4-c5cd57b2bb25",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont des ressources financières des ménages ?",
    "back": "Le salaire, le profit de l'entreprise individuelle, les revenus du patrimoine particulier, les pensions de retraite, les indemnités de congé maladie, les allocations familiales et les bourses des étudiants.",
    "createdAt": "2000-01-01T00:00:43.000Z"
   },
   {
    "id": "1ba17a83-c43b-5c55-ada3-b226488af842",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont des ressources financières des sociétés financières ?",
    "back": "Le profit et les intérêts des prêts.",
    "createdAt": "2000-01-01T00:00:44.000Z"
   },
   {
    "id": "d6d84cca-179c-54ba-bb10-ad0332057662",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont des ressources financières des administrations publiques ?",
    "back": "Les prélèvements obligatoires (impôts et taxes) : la TVA et les cotisations sociales.",
    "createdAt": "2000-01-01T00:00:45.000Z"
   },
   {
    "id": "af3115a7-1dc3-5f0b-b7ca-4740072bbc46",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont des ressources financières des ISBLSM ?",
    "back": "Les adhésions et cotisations des membres, les subventions publiques, les revenus de la propriété et les dons.",
    "createdAt": "2000-01-01T00:00:46.000Z"
   },
   {
    "id": "f5713101-2005-5b56-af7c-f9839ccb95b9",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "e5bd1d2e-9d1c-520a-a82d-104de9ce12b4",
    "front": "Quelles sont des ressources financières du reste du monde ?",
    "back": "Le montant des importations et des exportations de biens et services.",
    "createdAt": "2000-01-01T00:00:47.000Z"
   }
