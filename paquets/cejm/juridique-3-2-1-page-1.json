    "deletedAt": null,
    "subjectId": "97f9aa4d-0953-52a6-9296-aaaaeb9eeef6",
    "name": "Les structures juridiques - Page 1",
    "parentId": "0c2704b4-7a0b-5962-88bd-34dede5f23fa"
   }
  ],
  "cards": [
   {
    "id": "8de2374f-6c7a-5550-b77f-35b4157dd00a",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Qu'est-ce que la structure juridique d'une entreprise ?",
    "back": "Le cadre légal de l'activité de l'entrepreneur.",
    "createdAt": "2000-01-01T00:00:00.000Z"
   },
   {
    "id": "4a1b2d00-a482-5033-a8f0-c7eb2e002d38",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Quand analyse-t-on les critères de choix d'une structure juridique ?",
    "back": "À différents moments de la vie de l'entreprise, dès sa création et au cours de son évolution.",
    "createdAt": "2000-01-01T00:00:01.000Z"
   },
   {
    "id": "99be9b1b-6caf-5794-90fb-6eccbe5bb872",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Pour quelle entreprise l'entreprise individuelle classique est-elle adaptée ?",
    "back": "Une petite entreprise sans grande perspective de développement.",
    "createdAt": "2000-01-01T00:00:02.000Z"
   },
   {
    "id": "13c2967e-47dd-5bbb-be4e-3d0d65d88c88",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Quel régime ultra-simplifié l'entreprise individuelle peut-elle bénéficier ?",
    "back": "Celui de micro-entrepreneur.",
    "createdAt": "2000-01-01T00:00:03.000Z"
   },
   {
    "id": "40922bb5-6d26-57fb-aa6a-079e89304556",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Pour quelle entreprise une société est-elle adaptée ?",
    "back": "Une plus grande entreprise, au développement plus conséquent.",
    "createdAt": "2000-01-01T00:00:04.000Z"
   },
   {
    "id": "b143a29f-3f0b-5c2b-91eb-aa49f7346e49",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Quelle est la différence entre une société et une entreprise individuelle ?",
    "back": "Une société est une personne morale, contrairement à une entreprise individuelle.",
    "createdAt": "2000-01-01T00:00:05.000Z"
   },
   {
    "id": "4df64929-6be8-5c55-a714-6b73f7184306",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Que doit avoir une société en tant que personne morale ?",
    "back": "Un nom (la dénomination sociale), de l'argent et des biens (le capital social) et un domicile (le siège social).",
    "createdAt": "2000-01-01T00:00:06.000Z"
   },
   {
    "id": "30453593-cbb5-534e-aa11-db0e0b312a26",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Quelles sont les structures sociétaires à un seul associé ?",
    "back": "La SASU et l'EURL.",
    "createdAt": "2000-01-01T00:00:07.000Z"
   },
   {
    "id": "98437963-b5d4-5777-bb08-0cddee2a9804",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Quelles sont les structures sociétaires à plusieurs associés ?",
    "back": "La SA, la SAS et la SARL.",
    "createdAt": "2000-01-01T00:00:08.000Z"
   },
   {
    "id": "487440c0-a11c-59b1-83e6-86b25df16fbf",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Que signifient SASU, EURL, SA, SAS et SARL ?",
    "back": "SASU : société par actions simplifiée unipersonnelle. EURL : entreprise unipersonnelle à responsabilité limitée. SA : société anonyme. SAS : société par actions simplifiée. SARL : société à responsabilité limitée.",
    "createdAt": "2000-01-01T00:00:09.000Z"
   },
   {
    "id": "735eb7f9-9a57-53f6-96b6-be5a098ac2f9",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Qu'est devenue l'EIRL ?",
    "back": "Elle a disparu le 14 février 2022.",
    "createdAt": "2000-01-01T00:00:10.000Z"
   },
   {
    "id": "3cb2e667-6055-5110-9b0b-052b44e01e42",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Qu'est-ce que le contrat de société (art. 1832 du Code civil) ?",
    "back": "Le contrat par lequel deux ou plusieurs personnes conviennent d'affecter à une entreprise commune des biens ou leur industrie, en vue de partager le bénéfice ou de profiter de l'économie qui pourra en résulter.",
    "createdAt": "2000-01-01T00:00:11.000Z"
   },
   {
    "id": "3ce137a1-5a44-5e55-ac94-d54fd8cf0a05",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "Une société peut-elle être créée par une seule personne ?",
    "back": "Oui, dans les cas prévus par la loi, par l'acte de volonté d'une seule personne.",
    "createdAt": "2000-01-01T00:00:12.000Z"
   },
   {
    "id": "ced26d5e-5041-5a74-8ca0-9f5b4f1b6526",
    "updatedAt": "2000-01-01T00:00:00.000Z",
    "deletedAt": null,
    "deckId": "a76bf0c2-0670-54ea-9edc-3aade061e37d",
    "front": "À quoi s'engagent les associés d'une société ?",
    "back": "À contribuer aux pertes.",
    "createdAt": "2000-01-01T00:00:13.000Z"
   }
  ],
